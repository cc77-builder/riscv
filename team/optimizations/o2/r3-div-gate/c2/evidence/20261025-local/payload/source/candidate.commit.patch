From 6704ce3502a7235cdb81697638c01ed23f6914f6 Mon Sep 17 00:00:00 2001
From: cc77-builder <334095609+cc77-builder@users.noreply.github.com>
Date: Sun, 25 Oct 2026 20:12:33 +0800
Subject: [PATCH] perf(vdot): decouple DIV clock launch from ready after G0
 proof

---
 .../scala/xiangshan/backend/exu/ExeUnit.scala | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/main/scala/xiangshan/backend/exu/ExeUnit.scala b/src/main/scala/xiangshan/backend/exu/ExeUnit.scala
index 664b11a0..a28f5024 100644
--- a/src/main/scala/xiangshan/backend/exu/ExeUnit.scala
+++ b/src/main/scala/xiangshan/backend/exu/ExeUnit.scala
@@ -93,6 +93,7 @@ class ExeUnitImp(
   // for clock holds; the old busy value still supplies the cancellation edge.
   private val elasticDivClockBusy = if (vdotElastic) Some(WireDefault(false.B)) else None
   private val elasticDivClockOwnerIsFp = if (vdotElastic) Some(WireDefault(false.B)) else None
+  private val elasticDivClockStartAllowed = if (vdotElastic) Some(WireDefault(false.B)) else None
 
   if (EnableClockGate) {
     fuCfgs.zip(funcUnits).foreach { case (cfg, fu) =>
@@ -147,6 +148,19 @@ class ExeUnitImp(
         clk_en := true.B
       }
 
+      if (ownedDivGate) {
+        // G0: after valid reset, an unoccupied DIV has both children ready.
+        // Keep actual dispatch/acceptance unchanged; only the clock launch
+        // avoids the shared ready/fire tree. Old busy preserves release edges.
+        val clockStart = io.in.valid && cfg.fuSel(io.in.bits) &&
+          elasticDivClockStartAllowed.get
+        clk_en := clockStart || uncer_en_reg
+        when(!reset.asBool) {
+          assert(clockStart === fu.io.in.fire,
+            "C2 DIV clock launch must equal the actual selected acceptance")
+        }
+      }
+
       if (vdotElastic && cfg.fuType == FuType.vdot) {
         // These are actual, unmasked slot registers. Keep the clearing edge
         // even when this cycle's redirect kills every slot. Reset also opens
@@ -181,6 +195,11 @@ class ExeUnitImp(
     val divOutValid = divUnits.map(_.io.out.valid).reduce(_ || _)
     val divOutFire = divUnits.map(_.io.out.fire).reduce(_ || _)
     val divReady = divUnits.map(_.io.in.ready).reduce(_ && _)
+    elasticDivClockStartAllowed.get := !divBusy && !divOutValid &&
+      !elasticVDotOccupied.get && !io.flush.valid && !reset.asBool
+    when(!reset.asBool) {
+      assert(divBusy || divReady, "C2 idle DIV children must both be ready")
+    }
     val divCancelled = divBusy && divRobIdx.needFlush(io.flush)
     when(divCancelled) {
       divBusy := false.B
-- 
2.34.1

