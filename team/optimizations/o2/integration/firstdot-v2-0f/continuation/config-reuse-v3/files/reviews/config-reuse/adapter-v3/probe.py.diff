+def process_inputs(common):
+    """Keep the comparison BIN in outer closure, only the loaded BIN in a run.
+
+    The legacy unchanged checker interprets every /vdot-perf.bin key as the
+    actual loaded image. The exact shared map (including comparison BIN) is
+    still verified before/after each process and independently by raw audit.
+    """
+    comparison = [key for key in common if key.endswith("/vdot-perf.bin")]
+    require(len(comparison) == 1, "exactly one shared comparison BIN required")
+    path = comparison[0]
+    require(Path(path).is_file() and not Path(path).is_symlink()
+            and sha(path) == common[path], "comparison BIN changed")
+    return {key: value for key, value in common.items() if key != path}
 
 
