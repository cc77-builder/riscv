    "edits": [
      [
        "/* Full forward measurement; all validation/UART are outside the pure call. */",
        "/* First full forward: method load and dispatch are included; validation/UART are outside. */"
      ],
      [
        "#include \"consumer_w2.h\"",
        "#include \"consumer_w2.h\"\nextern float *r2_w2_gs32_forward(struct r2_consumer_state *,int,int);\nextern float *r2_w2_paired16_forward(struct r2_consumer_state *,int,int);\n"
      ],
      [
        "/* FR_CACHE/TA_CACHE, actual application negative, UART enabled. */",
        "/* Private experiment selector, application negative, UART; old public enum is unchanged. */"
      ],
      [
        "={4,0,1};",
        "={3,0,1};"
      ],
      [
        "0x52324e5447543031",
        "0x5232465752565631"
      ],
      [
        "int team_forward_main(void) {",
        "/* Method load, validation and dispatch are entirely inside the measured call. */\n__attribute__((noinline,noclone)) static float *first_forward_dispatch(void) {\n    method=target_control[0];\n    switch(method) {\n        case 3u: return r2_w2_forward(&target_state,R2_FR_CACHE,1,0);\n        case 0x47533332u: return r2_w2_gs32_forward(&target_state,1,0);\n        case 0x50313631u: return r2_w2_paired16_forward(&target_state,1,0);\n        default: reject(88,0);\n    }\n}\nint team_forward_main(void) {"
      ],
      [
        "    method=target_control[0];negative=target_control[1];uart=target_control[2];",
        "    negative=target_control[1];uart=target_control[2];"
      ],
      [
        "target_report[1]=1;target_report[2]=method;target_report[3]=1;",
        "target_report[1]=1;target_report[2]=0;target_report[3]=1;"
      ],
      [
        "check((method==R2_FR_CACHE || method==R2_TA_CACHE) && negative<=1 && uart<=1,82);",
        "check(negative<=1 && uart<=1,82);"
      ],
      [
        "    if(uart)printf(\"CONSUMER_BEGIN method=%u token=1 position=0 negative=%u\\n\",method,negative);",
        "    if(uart)printf(\"CONSUMER_BEGIN token=1 position=0\\n\");"
      ],
      [
        "    float *logits=r2_w2_forward(&target_state,(enum r2_consumer_method)method,1,0);",
        "    __asm__ volatile(\".global first_forward_call_begin\\nfirst_forward_call_begin:\":::\"memory\");\n    float *logits=first_forward_dispatch();\n    __asm__ volatile(\".global first_forward_call_end\\nfirst_forward_call_end:\":::\"memory\");"
      ],
      [
        "    target_report[16]=c0;",
        "    target_report[2]=method;target_report[16]=c0;"
      ]
    ],
