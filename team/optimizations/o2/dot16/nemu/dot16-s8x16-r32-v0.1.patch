diff --git a/src/isa/riscv64/instr/rvv/vdot16.h b/src/isa/riscv64/instr/rvv/vdot16.h
new file mode 100644
--- /dev/null
+++ b/src/isa/riscv64/instr/rvv/vdot16.h
@@ -0,0 +1,37 @@
+/* Team extension candidate: dot16-s8x16-r32-v0.1; Mulan PSL v2. */
+#ifdef CONFIG_CUSTOM_VDOT16
+_Static_assert(VLEN == 128, "dot16-s8x16-r32-v0.1 requires VLEN=128");
+bool vp_enable();
+void vp_set_dirty();
+
+def_EHelper(vdot16) {
+  /* Reject the entire request before source reads, destination writes or VS. */
+  if (!vp_enable() || vtype->vill || vtype->pad || vtype->vsew != 0 ||
+      vtype->vlmul != 0 || vl->val != 16 || vstart->val != 0) {
+    longjmp_exception(EX_II);
+  }
+
+  const uint32_t word = s->isa.instr.val;
+  const unsigned vs1 = (word >> 15) & 31;
+  const unsigned vs2 = (word >> 20) & 31;
+  const unsigned vd = (word >> 7) & 31;
+  /* All four halves are captured before writing, including any v0 aliases. */
+  const uint64_t a[2] = {cpu.vr[vs1]._64[0], cpu.vr[vs1]._64[1]};
+  const uint64_t b[2] = {cpu.vr[vs2]._64[0], cpu.vr[vs2]._64[1]};
+  int32_t sum = 0;
+  for (unsigned i = 0; i < 16; ++i) {
+    const unsigned half = i / 8;
+    const unsigned shift = 8 * (i % 8);
+    const uint8_t byte_a = a[half] >> shift;
+    const uint8_t byte_b = b[half] >> shift;
+    const int32_t x = byte_a < 128 ? byte_a : (int32_t)byte_a - 256;
+    const int32_t y = byte_b < 128 ? byte_b : (int32_t)byte_b - 256;
+    sum += x * y;
+  }
+  /* Widen the unsigned 32-bit field, not the signed result, to low 64 bits. */
+  cpu.vr[vd]._64[0] = (uint32_t)sum;
+  cpu.vr[vd]._64[1] = 0;
+  vp_set_dirty();
+  /* vl/vtype/vstart/vxrm/vxsat/vcsr/fflags are unchanged. */
+}
+#endif
diff --git a/src/isa/riscv64/local-include/vdot16_tval.h b/src/isa/riscv64/local-include/vdot16_tval.h
new file mode 100644
--- /dev/null
+++ b/src/isa/riscv64/local-include/vdot16_tval.h
@@ -0,0 +1,16 @@
+/* Team candidate platform adapter; Mulan PSL v2.
+ * Independent of the frozen dot8 policy. This predicate is not evidence that
+ * a new XiangShan build implements the proposed FU-only illegal-VL policy.
+ * It only inspects architectural instruction/configuration state.
+ */
+#ifndef XS_VDOT16_TVAL_POLICY_H
+#define XS_VDOT16_TVAL_POLICY_H
+#include <stdbool.h>
+#include <stdint.h>
+static inline bool xs_vdot16_tval_is_zero(uint32_t instruction, bool vector_enabled,
+                                         uint64_t type, uint64_t length, uint64_t start) {
+  return (instruction & UINT32_C(0xfe00707f)) == UINT32_C(0x0e00000b) &&
+         vector_enabled && (type & ~UINT64_C(0xc0)) == 0 &&
+         start == 0 && length != 16;
+}
+#endif
