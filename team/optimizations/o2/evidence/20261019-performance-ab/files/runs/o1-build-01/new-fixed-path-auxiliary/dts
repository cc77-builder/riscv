	L0: memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0xffff 0x80000000 0x0 0x80000000 0xffff 0x80000000>;
	};
	L15: soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "freechips,rocketchip-unknown-soc", "simple-bus";
		ranges;
		L13: bus-error-unit {
			compatible = "sifive,buserror0";
			interrupt-parent = <&L3>;
			interrupts = <65>;
		};
		L2: clint@38000000 {
