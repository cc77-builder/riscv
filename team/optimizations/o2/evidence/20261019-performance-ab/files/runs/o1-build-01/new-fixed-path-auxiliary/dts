	compatible = "freechips,rocketchip-unknown-dev";
	model = "xiangshan,Kunminghu-dev-a239dace (riscv@ZJH) # Oct 19 05:06:21 2026";
	L16: cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency;
