   private val eewVd = SewOH(vdType(1, 0))
   private val isVwsll = opcode.isVwsll
 
+  /*
+   * vdot.vv:
+   *   vd[31:0] = sum_{i=0}^{7} signed(vs1[i]) * signed(vs2[i])
+   *   vd[127:32] = 0
+   *
+   * Eight signed int8 products are reduced with a balanced adder tree.
+   */
+  private val isVdot = fuOpType === VialuFixType.vdot_vv
+
+  private val vdotProducts = Seq.tabulate(8) { i =>
+    vs1(8 * i + 7, 8 * i).asSInt *
+      vs2(8 * i + 7, 8 * i).asSInt
+  }
+
+  private val vdotSumLevel1 = Seq.tabulate(4) { i =>
+    vdotProducts(2 * i) +& vdotProducts(2 * i + 1)
+  }
+
+  private val vdotSumLevel2 = Seq.tabulate(2) { i =>
+    vdotSumLevel1(2 * i) +& vdotSumLevel1(2 * i + 1)
+  }
+
+  private val vdotSum = vdotSumLevel2(0) +& vdotSumLevel2(1)
+
+  private val vdotSum32 = Wire(SInt(32.W))
+  vdotSum32 := vdotSum
+
+  private val vdotResult =
+    Cat(0.U((dataWidth - 32).W), vdotSum32.asUInt)
+
+  // VIAluFix is configured as a one-cycle pipelined functional unit.
+  private val outIsVdot = RegEnable(isVdot, io.in.valid)
+  private val outVdotResult = RegEnable(vdotResult, io.in.valid)
+
   // Extension instructions
   private val vf2 = isVextF2
   private val vf4 = isVextF4
