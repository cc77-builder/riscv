+  // vdot.vv is fixed to eight signed bytes and LMUL=m1.  The result is a
+  // zero-extended 32-bit word in the low destination bits; upper bits are
+  // architecturally cleared.  Compute from the delayed operand bundle so the
+  // result follows the normal two-cycle VIMac writeback timing.
+  private val vdotProducts = Seq.tabulate(8) { i =>
+    outData.src(0)(i * 8 + 7, i * 8).asSInt * outData.src(1)(i * 8 + 7, i * 8).asSInt
+  }
+  private val vdotPairSums = Seq.tabulate(4) { i =>
+    vdotProducts(2 * i) +& vdotProducts(2 * i + 1)
+  }
+  private val vdotQuadSums = Seq.tabulate(2) { i =>
+    vdotPairSums(2 * i) +& vdotPairSums(2 * i + 1)
+  }
+  private val vdotSum = vdotQuadSums(0) +& vdotQuadSums(1)
+  private val vdotData = Cat(0.U((dataWidth - 32).W), vdotSum.pad(32).asUInt)
+  private val vdotIllegal = outVecCtrl.vsew =/= VSew.e8 ||
+    outVecCtrl.vlmul =/= VLmul.m1 || !outVm || outVecCtrl.vstart =/= 0.U
+
+  io.out.bits.res.data := Mux(isVdot, vdotData, mgu.io.out.vd)
+  io.out.bits.res.vxsat.get := Mux(isVdot, false.B, (outVxsat & mgu.io.out.active).orR)
+  io.out.bits.ctrl.exceptionVec.get(ExceptionNO.illegalInstr) := Mux(isVdot, vdotIllegal, mgu.io.out.illegal)
 }
