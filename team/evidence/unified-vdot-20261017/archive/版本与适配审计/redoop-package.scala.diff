+    object INT {
+      def width = 1
+
+      def S = "b1".U(width.W)
+      def U = "b0".U(width.W)
+      def X = "b0".U(width.W)
+    }
+
+    object FMT {
+      def width = 1
+
+      // vdot: INT8 x INT8 -> INT32 within one 128-bit register group.
+      // No RVV-style 2-uop widening split is needed: one uop per lmul group
+      // reads 16 x INT8 from vs1/vs2 and produces 4 x INT32 (128-bit vd).
+      def VVV = 0.U(width.W)
+    }
+
+    // pad:2bits  vs2 sign, vs1 sign, vd sign:3bits  format:1bit  opcode:3bits
+    def dummy              = BitPat.Y(OpTypeWidth) // exu not implemented
+    def vdot               = LiteralCat(0.U(2.W), INT.S, INT.S, INT.S, FMT.VVV, VdotOpcode.vdot)  // "b00_111_0_000"
+
+    def getOpcode(fuOpType: UInt) : UInt = fuOpType(2, 0)
+    def getFormat(fuOpType: UInt) : UInt = fuOpType(3)
+
+    def vs2Sign(fuOpType: UInt) = fuOpType(6)
+    def vs1Sign(fuOpType: UInt) = fuOpType(5)
+    def vdSign (fuOpType: UInt) = fuOpType(4)
+
+    def getSrcVdType(fuOpType: UInt, sew: UInt) = {
+      val vs2Sign = fuOpType(6)
+      val vs1Sign = fuOpType(5)
+      val vdSign  = fuOpType(4)
+      // vdot fixes the source EEW to 8 (INT8) and the dest EEW to 32 (INT32),
+      // independent of the vsetvl vsew.
+      val vs2Type = Cat(0.U(1.W), vs2Sign, "b00".U(2.W)) // e8
+      val vs1Type = Cat(0.U(1.W), vs1Sign, "b00".U(2.W)) // e8
+      val vdType  = Cat(0.U(1.W), vdSign , "b10".U(2.W)) // e32
+      Cat(vs2Type, vs1Type, vdType)
+    }
+  }
