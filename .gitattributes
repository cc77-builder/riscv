# Team scripts and sources must retain LF when copied between Windows and WSL.
/.gitattributes text eol=lf
team/** text eol=lf
team/**/*.log -text -whitespace
# Configuration sources retain their recorded LF bytes.
src/main/scala/xiangshan/backend/fu/FuConfig.scala text eol=lf
src/main/scala/xiangshan/backend/fu/FuType.scala text eol=lf
# Decode/integration sources share canonical Linux/Windows bytes.
src/main/scala/xiangshan/Parameters.scala text eol=lf
src/main/scala/xiangshan/backend/decode/DecodeUnit.scala text eol=lf
src/main/scala/xiangshan/backend/decode/isa/bitfield/RiscvInst.scala text eol=lf
src/main/scala/xiangshan/backend/fu/wrapper/CSR.scala text eol=lf

# Source-bound VFEX4/T15 checks must use identical checkout bytes on Windows/WSL.
/build.sc text eol=lf
src/main/scala/xiangshan/backend/fu/wrapper/VDot.scala text eol=lf
src/main/scala/xiangshan/backend/fu/vector/VDotDatapath.scala text eol=lf
