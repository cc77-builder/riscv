# Team scripts and sources must retain LF when copied between Windows and WSL.
team/** text eol=lf
team/**/*.log -text -whitespace

# Sealed O1 evidence keeps exact bytes, including gzip and patch context.
team/optimizations/o1/evidence/20261018-fullcore-validation/** -text -whitespace

# Sealed O2 run logs, gzip and source snapshots retain exact evidence bytes.
team/optimizations/o2/evidence/20261019-elastic-parent/** -text -whitespace

# G3 archive streams and compressed evidence retain their original bytes.
team/optimizations/o2/evidence/20261019-fullcore-validation/** -text -whitespace

# G4 log, ELF and gzip evidence must retain the exact original bytes.
team/optimizations/o2/evidence/20261019-performance-ab/** -text -whitespace
team/workloads/o3-gemv/evidence/20261020-application/** -text -whitespace

# O2 R0/R1 and H1 evidence must retain exact bytes for manifest verification.
team/optimizations/o2/repro/evidence/** -text -whitespace
team/optimizations/o2/result-width/evidence/** -text -whitespace
team/optimizations/o2/result-width/h1/evidence/** -text -whitespace
team/optimizations/o2/result-width/h1/fullcore/evidence/** -text -whitespace
team/optimizations/o2/result-width/h1/fullcore/reviews/** -text -whitespace
team/optimizations/o2/result-width/h1/performance/evidence/** -text -whitespace
team/optimizations/o2/result-width/h1/performance/windows-portable.json -text -whitespace
team/optimizations/o2/result-width/h1/timing-comparison.csv -text -whitespace
